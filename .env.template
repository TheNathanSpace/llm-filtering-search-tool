# Copy this file to `.env` in the project root (`cp .env.template .env`), then fill in real values.
# The app loads `.env` via python-dotenv (`backend/llm_rankings/util.py`). `.env` is gitignored.

# Artificial Analysis API key (required to fetch benchmarks).
# Get a key from: https://artificialanalysis.ai/
AA_API_KEY=<your-artificial-analysis-api-key>

# OpenRouter API key (required to fetch model/pricing metadata).
# Get a key from: https://openrouter.ai/
OR_API_KEY=<your-openrouter-api-key>

# Directory for SQLite DB, OpenAPI export, and intermediate fetch/match artifacts.
# Resolved relative to the directory that contains `.env` (normally the project root).
DATA_DIR=./data
