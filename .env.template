# Local development and host tooling. Copy to `.env` (`cp .env.template .env`).
# `docker-compose.local.yaml` reads this file (env_file, the /app/.env mount, and
# Compose interpolation for ports, COMPOSE_PROFILES, and HOST_DATA_DIR).
#
# Server deploy does not need this file. Set values in docker-compose.yaml.
# To use an env file there instead, point the service at it with env_file.
# `.env` is gitignored. The back-end keeps variables already set in the process
# environment and fills gaps from this file when it is present.

# OpenRouter API key (required to fetch models, pricing, and embedded benchmarks).
# Get a key from: https://openrouter.ai/
OR_API_KEY=<your-openrouter-api-key>

# Optional: gap-fill missing open-weights / parameter size via
# OpenRouter Batch (hardcoded openai/gpt-6-luna:batch on /v1/responses with OpenAI
# native web_search) when OpenRouter / models.dev / Hugging Face leave gaps. Off by
# default (refresh stays cheap). When enabled, the refresh job waits for the batch
# (up to 24h), but the live DB keeps serving until the staging rebuild swaps in.
# The batch id is saved under DATA_DIR/cache/web_enrichment/active_batch.json and
# resumed after a restart instead of submitting another batch.
# OR_WEB_ENRICHMENT=1
# Costs are logged and written under DATA_DIR/cache/web_enrichment/ (cost_ledger.jsonl,
# cost_summary.json); cache entries survive wipe/refresh.

# Optional Hugging Face Hub token. Raises rate limits for parameter-count enrichment
# (https://huggingface.co/settings/tokens). Leave unset for anonymous requests.
# HF_TOKEN=

# Directory for SQLite DB, OpenAPI export, intermediate fetch/match artifacts, and logs.
# Resolved relative to the `.env` directory when that file is loaded, otherwise
# relative to the working directory. The server compose file sets DATA_DIR=/app/data.
# Durable HTTP caches for models.dev / Hugging Face / opt-in web enrichment live under
# DATA_DIR/cache/ and survive wipe/refresh so unauthenticated APIs (and paid batch
# enrichment) are not re-hit unnecessarily.
DATA_DIR=./data

# Host path docker-compose.local.yaml bind-mounts to /app/data (defaults to ./data).
# Worktree setup sets this to the primary checkout's data/ so preview stacks
# reuse the warm DB/cache instead of refreshing from an empty worktree data dir.
# Leave unset in the primary checkout.
# HOST_DATA_DIR=/absolute/path/to/primary/data

# Back-end logging (stdlib logging; named module loggers inherit these settings).
# Also filters front-end lines appended to DATA_DIR/logs/latest.log.
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=DEBUG
# Maximum number of timestamped `DATA_DIR/logs/*.log` files to keep; oldest are deleted on startup.
# (`latest.log` is a symlink to the current file and is not counted.)
LOG_FILE_COUNT=10

# FastAPI listen address and port.
# Use BACKEND_HOST=0.0.0.0 to expose the API on all interfaces.
# At runtime, frontend/proxy.ts rewrites /api/* to http://<host>:<port>
# (0.0.0.0 is mapped to 127.0.0.1 for the proxy target). Host/port are read when
# each request is handled, so Docker -e overrides work without rebuilding.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Serve FastAPI /docs, /redoc, and /openapi.json when set to 1/true/yes/on.
# Off by default (safer for exposed instances). Compose `dev` profile forces this on.
# ENABLE_API_DOCS=1

# Optional. Public origin of another running instance (scheme, host, and port;
# no path). On each API start, replace this instance's SQLite tables and
# DATA_DIR/cache from that origin's /api/export snapshot. The page keeps a
# warning up until this variable is removed and the process restarts, so a
# later start does not download the snapshot again.
# EXPORT_BASE_URL=http://other-host:3030

# IANA timezone for container log timestamps (Python logs, log file names, and
# Next.js server lines). Examples: Etc/UTC, America/Denver. Unset uses Etc/UTC.
# Stored refresh and enrichment instants stay UTC.
# TZ=America/Denver

# Next.js front-end listen port (UI + same-origin /api proxy).
# Docker default ENV is also 3030; override with -e FRONTEND_PORT=... and publish
# the same container port (-p). Image EXPOSE 3030 is metadata for the default only.
FRONTEND_PORT=3030

# Docker Compose profile for docker-compose.local.yaml. `prod` = single supervisord image (default).
# `dev` = separate backend + frontend services with bind mounts and hot reload.
# Use exactly one: `COMPOSE_PROFILES=dev docker compose -f docker-compose.local.yaml up --build`
COMPOSE_PROFILES=prod
