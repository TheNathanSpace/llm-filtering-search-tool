# Copy this file to `.env` in the project root (`cp .env.template .env`), then fill in real values.
# Shared by the back-end (python-dotenv in `backend/llm_rankings/util.py`) and the front-end
# (`frontend/next.config.ts` loads this for `next dev`/`next build`; `frontend/proxy.ts` and
# start scripts also use these vars at runtime). `.env` is gitignored.

# OpenRouter API key (required to fetch models, pricing, and embedded benchmarks).
# Get a key from: https://openrouter.ai/
OR_API_KEY=<your-openrouter-api-key>

# Directory for SQLite DB, OpenAPI export, intermediate fetch/match artifacts, and logs.
# Resolved relative to the directory that contains `.env` (normally the project root).
DATA_DIR=./data

# Back-end logging (stdlib logging; named module loggers inherit these settings).
# Also filters front-end lines appended to DATA_DIR/logs/latest.log.
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=DEBUG
# Maximum number of timestamped `DATA_DIR/logs/*.log` files to keep; oldest are deleted on startup.
# (`latest.log` is a symlink to the current file and is not counted.)
LOG_FILE_COUNT=10

# FastAPI listen address and port.
# Use BACKEND_HOST=0.0.0.0 to expose the API on all interfaces.
# At runtime, frontend/proxy.ts rewrites /api/* to http://<host>:<port>
# (0.0.0.0 is mapped to 127.0.0.1 for the proxy target). Host/port are read when
# each request is handled, so Docker -e overrides work without rebuilding.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Next.js front-end listen port (UI + same-origin /api proxy).
# Docker default ENV is also 3030; override with -e FRONTEND_PORT=... and publish
# the same container port (-p). Image EXPOSE 3030 is metadata for the default only.
FRONTEND_PORT=3030
