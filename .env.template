# Copy this file to `.env` in the project root (`cp .env.template .env`), then fill in real values.
# Shared by Docker Compose (env_file), the back-end (python-dotenv in `backend/llm_rankings/util.py`),
# and the front-end (`frontend/next.config.ts` / `frontend/proxy.ts`). `.env` is gitignored.

# OpenRouter API key (required to fetch models, pricing, and embedded benchmarks).
# Get a key from: https://openrouter.ai/
OR_API_KEY=<your-openrouter-api-key>

# Optional: gap-fill missing open-weights / parameter size / knowledge cutoff via
# OpenRouter chat + Exa web search when OpenRouter / models.dev / Hugging Face leave
# gaps. Off by default (refresh stays cheap).
# When enabled, OR_ENRICHMENT_MODEL is required (any OpenRouter chat model id).
# OR_WEB_ENRICHMENT=1
# OR_ENRICHMENT_MODEL=<openrouter-model-id>
# Costs are logged and written under DATA_DIR/cache/web_enrichment/ (cost_ledger.jsonl,
# cost_summary.json); cache entries survive wipe/refresh.

# Optional Hugging Face Hub token. Raises rate limits for parameter-count enrichment
# (https://huggingface.co/settings/tokens). Leave unset for anonymous requests.
# HF_TOKEN=

# Directory for SQLite DB, OpenAPI export, intermediate fetch/match artifacts, and logs.
# Resolved relative to the directory that contains `.env` (normally the project root).
# Durable HTTP caches for models.dev / Hugging Face / opt-in web enrichment live under
# DATA_DIR/cache/ and survive wipe/refresh so unauthenticated APIs (and paid Exa calls)
# are not re-hit unnecessarily.
DATA_DIR=./data

# Host path Compose bind-mounts to /app/data (defaults to ./data).
# Worktree setup sets this to the primary checkout's data/ so preview stacks
# reuse the warm DB/cache instead of refreshing from an empty worktree data dir.
# Leave unset in the primary checkout.
# HOST_DATA_DIR=/absolute/path/to/primary/data

# Back-end logging (stdlib logging; named module loggers inherit these settings).
# Also filters front-end lines appended to DATA_DIR/logs/latest.log.
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=DEBUG
# Maximum number of timestamped `DATA_DIR/logs/*.log` files to keep; oldest are deleted on startup.
# (`latest.log` is a symlink to the current file and is not counted.)
LOG_FILE_COUNT=10

# FastAPI listen address and port.
# Use BACKEND_HOST=0.0.0.0 to expose the API on all interfaces.
# At runtime, frontend/proxy.ts rewrites /api/* to http://<host>:<port>
# (0.0.0.0 is mapped to 127.0.0.1 for the proxy target). Host/port are read when
# each request is handled, so Docker -e overrides work without rebuilding.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Serve FastAPI /docs, /redoc, and /openapi.json when set to 1/true/yes/on.
# Off by default (safer for exposed instances). Compose `dev` profile forces this on.
# ENABLE_API_DOCS=1

# Next.js front-end listen port (UI + same-origin /api proxy).
# Docker default ENV is also 3030; override with -e FRONTEND_PORT=... and publish
# the same container port (-p). Image EXPOSE 3030 is metadata for the default only.
FRONTEND_PORT=3030

# Docker Compose profile. `prod` = single supervisord image (default).
# `dev` = separate backend + frontend services with bind mounts and hot reload.
# Use exactly one: `COMPOSE_PROFILES=dev docker compose up --build`
COMPOSE_PROFILES=prod
